<resources>
    <!-- Material You dynamic color themes for Android 12+ -->
    <!-- These themes inherit from the base themes but enable dynamic colors from the system -->
    
    <style name="PinkAppTheme" parent="Theme.Material3.DynamicColors.Light.NoActionBar">
        <item name="drawerArrowStyle">@style/DrawerArrowStyle</item>
        <item name="actionModeCloseDrawable">@drawable/ic_close_black_24dp</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="android:fontFamily">@font/arvo</item>
        <!-- Fallback colors when dynamic colors are not available -->
        <item name="colorPrimary">@color/pinkColorPrimary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/pinkColorPrimaryLight</item>
        <item name="colorOnPrimaryContainer">@color/pinkColorPrimaryDark</item>
        <item name="colorSecondary">@color/pinkColorAccent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/pinkColorAccent</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <item name="colorTertiary">@color/pinkColorTertiary</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/pinkColorTertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/pinkColorPrimaryDark</item>
        <item name="colorError">@color/errorLight</item>
        <item name="colorOnError">@color/onErrorLight</item>
        <item name="colorErrorContainer">@color/errorContainerLight</item>
        <item name="colorOnErrorContainer">@color/onErrorContainerLight</item>
    </style>

