<resources>
    <!-- Material You dynamic color themes for Android 12+ -->
    <!-- These themes inherit from the base themes but enable dynamic colors from the system -->
    
    <style name="PinkAppTheme" parent="Theme.Material3.DynamicColors.Light">
        <item name="drawerArrowStyle">@style/DrawerArrowStyle</item>
        <item name="actionModeCloseDrawable">@drawable/ic_close_black_24dp</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="android:fontFamily">@font/arvo</item>
    </style>

    <style name="BlueAppTheme" parent="Theme.Material3.DynamicColors.Light">
        <item name="drawerArrowStyle">@style/DrawerArrowStyle</item>
        <item name="actionModeCloseDrawable">@drawable/ic_close_black_24dp</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="android:fontFamily">@font/arvo</item>
    </style>

    <style name="PurpleAppTheme" parent="Theme.Material3.DynamicColors.Light">
        <item name="drawerArrowStyle">@style/DrawerArrowStyle</item>
        <item name="actionModeCloseDrawable">@drawable/ic_close_black_24dp</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="android:fontFamily">@font/arvo</item>
    </style>

    <style name="GreenAppTheme" parent="Theme.Material3.DynamicColors.Light">
        <item name="drawerArrowStyle">@style/DrawerArrowStyle</item>
        <item name="actionModeCloseDrawable">@drawable/ic_close_black_24dp</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="android:fontFamily">@font/arvo</item>
    </style>
</resources>
