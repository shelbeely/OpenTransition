<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Vertical lines -->
    <item android:gravity="center">
        <shape android:shape="line">
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
    <item
        android:gravity="center_vertical|left"
        android:left="33%p">
        <shape android:shape="line">
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
    <item
        android:gravity="center_vertical|left"
        android:left="66%p">
        <shape android:shape="line">
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
    <!-- Horizontal lines -->
    <item
        android:gravity="top|center_horizontal"
        android:top="33%p">
        <shape android:shape="line">
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
    <item
        android:gravity="top|center_horizontal"
        android:top="66%p">
        <shape android:shape="line">
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
