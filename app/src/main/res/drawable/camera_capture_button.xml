<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer circle (white border) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <size
                android:width="72dp"
                android:height="72dp" />
        </shape>
    </item>
    <!-- Inner circle (transparent center) -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
